{
  "manifest_version": 3,
  "name": "HiddenTabby",
  "version": "0.2.2",
  "description": "Organize tabs into local workspaces across windows. Tab titles and URLs stay in this browser profile.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "tabGroups", "sessions", "contextMenus", "storage"],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open HiddenTabby",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "manager.html",
    "open_in_tab": true
  }
}
